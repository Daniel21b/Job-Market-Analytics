APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://skill_analytics:skill_analytics@postgres:5432/skill_analytics
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300
QUEUE_NAME=skill-analytics:runs
AUTO_CREATE_SCHEMA=true
SPARK_MASTER_URL=local[*]
SPARK_INPUT_URI=/data/input
SPARK_OUTPUT_URI=/data/output
SPARK_PARTITIONS=8
SKILL_TAXONOMY_PATH=/app/config/skill_taxonomy.csv
MINIMUM_CANONICAL_SKILLS=500
EXECUTION_BACKEND=local
AWS_REGION=us-east-1
AWS_S3_INPUT_BUCKET=
AWS_S3_OUTPUT_BUCKET=
AWS_EMR_SERVERLESS_APPLICATION_ID=
AWS_EMR_SERVERLESS_EXECUTION_ROLE_ARN=
AWS_EMR_SERVERLESS_ENTRYPOINT_URI=
AWS_EMR_SERVERLESS_LOG_URI=
